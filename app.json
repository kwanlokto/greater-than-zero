{
  "expo": {
    "name": "Greater Than Zero",
    "slug": "greater-than-zero",
    "version": "1.0.0",
    "platforms": [
      "android"
    ],
    "orientation": "portrait",
    "scheme": "greaterthanzero",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.rkwan.greater_than_zero",
      "allowBackup": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-blank.png",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-sqlite",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9a20df46-6d8b-40fc-a6d7-3be7214651a2"
      }
    }
  }
}
